@model ApnaBazaar.Models.MerchantTable
@{
    Layout = "_AuthLayout";
    ViewBag.title = "DigiLocker Verification";
}
<body class="bg-body-secondary">

    <!-- Navbar -->
    <nav class="navbar bg-primary border-bottom py-3">
        <div class="container">
            <a class="navbar-brand fw-bold text-white d-flex align-items-center gap-2"
               href="#">
                <i class="bi bi-shield-check fs-3"></i>
                DigiLocker Verification
            </a>
            <span class="badge text-bg-success">
                <i class="bi bi-lock-fill me-1"></i> Secure
            </span>
        </div>
    </nav>

    <!-- Verification Section -->
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-12 col-sm-10 col-md-8 col-lg-6 col-xl-5">

                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-body p-4 p-md-5">

                        <!-- Logo -->
                        <div class="text-center mb-4">
                            <div class="bg-primary-subtle text-primary rounded-4
                                d-inline-flex align-items-center justify-content-center
                                p-3 mb-3">
                                <i class="bi bi-person-vcard fs-1"></i>
                            </div>

                            <h3 class="fw-bold mb-2">Verify Your Identity</h3>

                            <p class="text-secondary small mb-0">
                                Verify your identity securely using DigiLocker
                                to continue with your application.
                            </p>
                        </div>

                        <!-- Progress -->
                        <div class="d-flex align-items-center justify-content-center
                            gap-2 mb-4">
                            <span class="badge rounded-pill text-bg-primary">1</span>
                            <span class="small fw-semibold">Identity</span>
                            <i class="bi bi-chevron-right text-secondary"></i>
                            <span class="badge rounded-pill text-bg-secondary">2</span>
                            <span class="small text-secondary">Verification</span>
                        </div>

                        <!-- Info -->
                        <div class="alert alert-info border-0 rounded-3 small">
                            <i class="bi bi-info-circle-fill me-2"></i>
                            Enter your details to proceed with identity
                            verification through the authorized DigiLocker service.
                        </div>

                        <!-- Form UI -->
                        <form asp-controller="Merchant"
                              asp-action="VerifyAadhar"
                              method="post" onsubmit="showspinner()">

                            <div class="mb-3">
                                <label for="aadhaar" class="form-label fw-semibold">
                                    Aadhaar Number
                                </label>

                                <input type="text"
                                       class="form-control form-control-lg"
                                       id="aadhaar"
                                       asp-for="aadharNumber"
                                       placeholder="Enter 12-digit Aadhaar number"
                                       inputmode="numeric"
                                       maxlength="12"
                                       readonly
                                       pattern="[0-9]{12}"
                                       autocomplete="off"
                                       required>

                                <div class="form-text">
                                    Enter your Aadhaar number only on the
                                    official, authorized verification flow.
                                </div>
                            </div>

                            <div class="form-check mb-4">
                                <input class="form-check-input"
                                       type="checkbox"
                                       value="true"
                                       id="consent"
                                       name="Consent"
                                       required>

                                <label class="form-check-label small"
                                       for="consent">
                                    I consent to identity verification and
                                    authorize the requested processing of my details.
                                </label>
                            </div>

                            <button type="submit" class="btn btn-primary btn-lg w-100 rounded-3">

                                <div class="spinner-grow spinner-grow-sm d-none" role="status" id="spinner">
                                    <span class="visually-hidden">Loading...</span>
                                </div>

                                 <span id="text">
                                    Continue to Verification
                                    <i class="bi bi-arrow-right ms-2"></i>
                                 </span>
                            </button>
                        </form>

                        <hr class="my-4">

                        <!-- Security Info -->
                        <div class="d-flex gap-3 align-items-start">
                            <i class="bi bi-shield-lock-fill text-success fs-4"></i>
                            <div>
                                <h6 class="fw-bold mb-1">Your data matters</h6>
                                <p class="text-secondary small mb-0">
                                    Use only the official DigiLocker authorization
                                    process. Never share your OTP or PIN with anyone.
                                </p>
                            </div>
                        </div>

                    </div>
                </div>

                <p class="text-center text-secondary small mt-4">
                    <i class="bi bi-lock me-1"></i>
                    Secure identity verification
                    <span class="mx-2">•</span>
                    <a href="#" class="text-decoration-none">Privacy Policy</a>
                </p>

            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

