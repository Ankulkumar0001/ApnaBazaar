@model ApnaBazaar.Models.changepassword
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
     Layout = "_shop-dashboardLayout";
    ViewBag.title = "Change Password - ApnaBazaar";
}
 <main class="main-content">

      <header class="top-header-bar">
        <div class="page-headline">
          <h1>Change Password (Password Badlein) 🔒</h1>
          <p>Apne merchant account ki suraksha ke liye naya majboot password banayein.</p>
        </div>
        <div>
          <a asp-action="MerchantProfile" asp-controller="Merchant" class="btn btn-secondary btn-sm">
            <i class="bi bi-person-gear"></i> Profile Settings
          </a>
        </div>
      </header>

      <!-- Security Guidance Box -->
      <div class="alert-box">
        <i class="bi bi-shield-check"></i>
        <div>
          <strong>Suraksha Salah:</strong> Naya password kisi ke sath share na karein aur aasan passwords (jaise 123456 ya apna naam) na rakhein.
        </div>
      </div>

      <!-- Change Password Form Section -->
      <section class="dashboard-section">
        <div class="section-head">
          <div>
            <h2 class="section-title"><i class="bi bi-key-fill"></i> Naya Password Set Karein</h2>
            <p class="section-subtitle">Purana password enter karke naya password banayein</p>
          </div>
        </div>

        <form asp-action="MerchantUpdatePassword" asp-controller="Merchant" method="post" onsubmit="showspinner()">
          <div class="form-grid">

            <!-- Current Password -->
            <div class="form-group form-grid-full">
              <label class="form-label">Purana Password (Current Password) *</label>
              <input type="password" class="form-control" asp-for="oldpassword" placeholder="Apna vartaman password darj karein" required />
              
            </div>

            <!-- New Password -->
            <div class="form-group">
              <label class="form-label">Naya Password (New Password) *</label>
              <input type="password" class="form-control" asp-for="newpassword" placeholder="Naya password likhein" minlength="6" required />
              <span class="form-helper">Kam se kam 6 akshar hone chahiye.</span>
            </div>

            <!-- Confirm New Password -->
            <div class="form-group">
              <label class="form-label">Naye Password Ki Pushti (Confirm Password) *</label>
              <input type="password" class="form-control"asp-for="confirmpassword" placeholder="Naya password dobara likhein" minlength="6" required />
            </div>

            <!-- Password Requirements Checklist -->
            <div class="form-group form-grid-full" style="background: #f8fafc; padding: 16px; border-radius: 8px; border: 1px solid var(--border-color);">
              <span class="form-label mb-1" style="font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.5px;">Password Ke Niyam:</span>
              <ul class="security-checklist">
                <li><i class="bi bi-check-circle-fill"></i> Kam se kam 8 characters hona jaruri hai</li>
                <li><i class="bi bi-check-circle-fill"></i> Kam se kam ek number (0-9) hona chahiye</li>
                <li><i class="bi bi-check-circle-fill"></i> Ek special character (@@, #, $, %, aadi) shamil karein</li>
              </ul>
            </div>

            

            <!-- Action Buttons -->
            <div class="form-group form-grid-full" style="display: flex; gap: 14px; margin-top: 12px; flex-wrap: wrap;">
              <button type="submit" class="btn btn-primary">

                <div class="spinner-grow spinner-grow-sm d-none" role="status" id="spinner">
                    <span class="visually-hidden">Loading...</span>
                </div>

                <span id="text"><i class="bi bi-shield-lock-fill"></i> Password Update Karein</span>
              </button>
              
            </div>

          </div>
        </form>
      </section>

    </main>