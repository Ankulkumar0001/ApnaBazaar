@model ApnaBazaar.Models.ProductAndStockCombineModel
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    Layout = "_shop-dashboardLayout";
    ViewBag.title = "Product And Stock - ApnaBazaar";
}
<main class="main-content">

    <header class="top-header-bar">
        <div class="page-headline">
            <h1>Dukaan Ka Stock &amp; Inventory 📦</h1>
            <p>Yahan aapke paas uplabdh sabhi items aur unki matra dekhi ja sakti hai.</p>
        </div>
        <div>
            <a asp-action="AddProduct" asp-controller="Merchant" class="btn btn-primary">
                <i class="bi bi-plus-circle-fill"></i> Naya Product Jodein
            </a>
        </div>

        <select class="form-select" onchange="changeShop(this)" id="shopSelect">
            <option value="">All Shop</option>
            @foreach(var row in Model.ShopData)
            {
                <option  selected="@(Context.Request.RouteValues["id"]?.ToString() == row.shop_id.ToString())" value="@row.shop_id">@row.shopname</option>
            }

            
        </select>
    </header>

    <!-- Inventory Metrics -->
    <section class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon-wrap green">
                <i class="bi bi-check2-circle"></i>
            </div>
            <div class="stat-data">
                <span class="stat-title">In Stock Items</span>
                <span class="stat-number">@ViewBag.InStock Items</span>
                <span class="stat-subtext">Bikri ke liye ready</span>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon-wrap amber">
                <i class="bi bi-exclamation-triangle-fill"></i>
            </div>
            <div class="stat-data">
                <span class="stat-title">Low Stock Items</span>
                <span class="stat-number">@ViewBag.LowStock Items</span>
                <span class="stat-subtext">Order karne ki jarurat</span>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon-wrap red">
                <i class="bi bi-x-circle-fill"></i>
            </div>
            <div class="stat-data">
                <span class="stat-title">Out of Stock</span>
                <span class="stat-number">@ViewBag.OutOfStock Items</span>
                <span class="stat-subtext">Khatam ho chuka hai</span>
            </div>
        </div>
    </section>

    <!-- Products Inventory Table -->
    <section class="dashboard-section">
        <div class="section-head">
            <div>
                <h2 class="section-title"><i class="bi bi-box-seam-fill"></i> Stock Suchi (Inventory List)</h2>
                <p class="section-subtitle">Sabhi items ka rate, category aur stock level</p>
            </div>
            <div>
                <button class="btn btn-sm mb-2 active btn-outline-info fw-bold border border-1 border-info"
                        type="button" onclick="show('all', this)">
                    All Products
                </button>

                <button class="btn btn-sm mb-2 btn-outline-success fw-bold border border-1 border-success"
                        type="button" onclick="show('instock', this)">
                    In Stock
                </button>

                <button class="btn btn-sm mb-2 btn-outline-warning fw-bold border border-1 border-warning"
                        type="button" onclick="show('lowstock', this)">
                    Low Stock
                </button>

                <button class="btn btn-sm mb-2 btn-outline-danger border border-1 border-danger fw-bold"
                        type="button" onclick="show('outofstock', this)">
                    Out of Stock
                </button>
            </div>
        </div>

        <div class="table-responsive">
            <table class="simple-table" id="myTable">
                <thead>
                    <tr>
                        <th>Product Name</th>
                        <th>Category</th>
                        <th>Selling Price</th>
                        <th>MRP</th>
                        <th>Stock Quantity</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        if(Model.ProductData!=null && Model.ProductData.Any())
                        {
                            foreach (var row in Model.ProductData)
                            {
                                 string stockStatus = row.product_stock == 0
                                    ? "outofstock"
                                    : row.product_stock <= row.product_lowstock
                                        ? "lowstock"
                                        : "instock";
                                 
                                <tr class="product-row @stockStatus">
                                    <td>
                                        <div class="product-cell">
                                            <span class="product-icon overflow-hidden"
                                                  style="width:40px;height:40px">
                                                <img src="~/images/@row.product_image"
                                                     height="100%" width="100%" />
                                            </span>

                                            <div>
                                                <div class="product-name-bold">
                                                    @row.product_name (@row.product_unit)
                                                </div>
                                                <div class="product-cat-small">
                                                    AB:PRDID-@row.product_id
                                                </div>
                                            </div>
                                        </div>
                                    </td>

                                    <td>@row.product_category</td>
                                    <td><strong>₹@row.product_selling_price</strong></td>
                                    <td><del>₹@row.product_mrp</del></td>
                                    <td>@row.product_stock Packets</td>

                                    <td>
                                        @if (stockStatus == "instock")
                                        {
                                            <span class="badge badge-success">In Stock</span>
                                        }
                                        else if (stockStatus == "lowstock")
                                        {
                                            <span class="badge badge-warning">Low Stock</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-danger">Out of Stock</span>
                                        }
                                    </td>

                                    <td>
                                        <a asp-action="EditProduct"
                                           asp-controller="Merchant"
                                           asp-route-id="@row.product_id">
                                            <span class="badge badge-success mb-2">
                                                <i class="bi bi-pencil-square"></i>
                                            </span>
                                        </a>
                                      

                                        <a href="javascript:void(0)"
                                           onclick="confirmDelete(@row.product_id)">
                                            <span class="badge badge-danger">
                                                <i class="bi bi-trash"></i>
                                            </span>
                                        </a>
                                    </td>
                                </tr>

                            }
                        }
                        
                    }
                </tbody>
            </table>
        </div>
    </section>

</main>
<script>
    function confirmDelete(productId) {
        Swal.fire({
            title: "Are you sure?",
            text: "You able to delete this product!",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#3085d6",
            cancelButtonColor: "#d33",
            confirmButtonText: "Yes, delete it!",
            cancelButtonText: "Cancel",
            reverseButtons: true
        }).then((result) => {
            if (result.isConfirmed) {
                window.location.href = `/Merchant/DeleteProduct/${productId}`;
            }
        });
    }
</script>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<script>
    function changeShop(select) {
        const shopId = select.value;

        if (shopId) {
            window.location.href =
                `/Merchant/ProductAndStock/${shopId}`;
        } else {
            window.location.href =
                `/Merchant/ProductAndStock`;
        }
    }
</script>





