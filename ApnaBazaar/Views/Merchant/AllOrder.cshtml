                        <td>
                            <div>Aashirvaad Atta 5kg, Fortune Oil 1L</div>
                            <span class="item-count-pill">2 items</span>
                        </td>
                        <td><strong>₹645</strong></td>
                        <td><span class="badge badge-success">Online Paid (UPI)</span></td>
                        <td><span class="badge badge-warning">New Order</span></td>
                    </tr>

                    <tr>
