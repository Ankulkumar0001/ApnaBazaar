                            <div>Basmati Rice 5kg, Rajma 1kg, Haldi Powder</div>
                            <span class="item-count-pill">3 items</span>
                        </td>
                        <td><strong>₹820</strong></td>
                        <td><span class="badge badge-success">Online Paid</span></td>
                        <td><span class="badge badge-success">Delivered</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>

</main>
