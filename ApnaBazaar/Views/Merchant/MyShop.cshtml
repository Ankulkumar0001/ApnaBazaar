@model IEnumerable<ApnaBazaar.Models.Shops_Table>
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    Layout = "_shop-dashboardLayout";
    ViewBag.title = "Shop Settings - ApnaBazaar";
}
<main class="main-content">

    <header class="top-header-bar">
        <div class="page-headline">
            <h1>My Shop (Shop Profile) ⚙️</h1>
            <span></span>
            <p>Yahan apni dukaan ka ko dekhe or manage kare </p>
        </div>
        <div style="display: flex; gap: 12px; align-items: center; flex-wrap: wrap;">

            @{
                if (ViewBag.isVerified == true)
                {
                    <a asp-action="AddNewShop" asp-controller="Merchant" class="btn btn-primary btn-sm">
                        <i class="bi bi-plus-circle-fill"></i> Add New Shop
                    </a>

                    <span class="header-status-pill shadow-sm text-success border border-1 border-success">
                        <span class="pulse-indicator bg-success "></span> Verified Merchant
                    </span>
                }
                else
                {
                    <a asp-action="VerifyAccount" asp-controller="Merchant" class="btn btn-sm btn-danger">Get Verify</a>

                    <a onclick="checkAlert()" class="btn btn-primary btn-sm">
                        <i class="bi bi-plus-circle-fill"></i> Add New Shop
                    </a>

                    <span class="header-status-pill shadow-sm text-danger border border-1 border-danger">
                        <span class="pulse-indicator bg-danger "></span> Verification Pending
                    </span>
                }
            }
        </div>
    </header>

    @{
        if(Model != null && Model.Any())
        {
            @foreach (var row in Model)
            {
                <div class="container-fluid py-3">

                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden"
                         style="max-width: 900px;">

                        <div class="card-body p-3 p-md-4">

                            <div class="row g-3">

                                <!-- Shop Image -->
                                <div class="col-12 col-sm-4 col-md-3">
                                    <div class="position-relative">
                                        @{
                                            if (row.image != null)
                                            {
                                                <img src="~/images/@row.image"
                                                     alt="FreshMart Store"
                                                     class="img-fluid w-100 rounded-3 border"
                                                     style="height: 180px; object-fit: cover;" />
                                            }
                                            else
                                            {
                                                <img src="~/images/shop-placeholder.png"
                                                     alt="FreshMart Store"
                                                     class="img-fluid w-100 rounded-3 border"
                                                     style="height: 180px; object-fit: cover;"
                                                     onerror="this.onerror=null;this.src='https://placehold.co/400x400/e8f5ec/198754?text=Shop+Image';" />
                                            }
                                        }

                                        @{
                                            if (row.isVerified != false)
                                            {
                                                <span class="position-absolute top-0 start-0 m-2 badge rounded-pill text-bg-success">
                                                    <i class="bi bi-patch-check-fill me-1"></i>Verified
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="position-absolute top-0 start-0 m-2 badge rounded-pill text-bg-danger">
                                                    <i class="bi bi-patch-check-fill me-1"></i>Verified
                                                </span>
                                            }
                                        }
                                    </div>

                                    <div class="d-flex gap-2 mt-2">
                                        <a asp-action="ShopSetting" asp-controller="Merchant" asp-route-id="@row.shop_id"
                                           class="btn btn-sm btn-outline-success flex-fill">
                                            <i class="bi bi-pencil-square me-1"></i>Edit
                                        </a>

                                        <a class="btn btn-sm btn-success flex-fill">
                                            <i class="bi bi-gear me-1"></i>Manage
                                        </a>
                                    </div>
                                </div>

                                <!-- Shop Details -->
                                <div class="col-12 col-sm-8 col-md-9">

                                    <div class="d-flex justify-content-between align-items-start gap-2">
                                        <div>
                                            <h5 class="fw-bold mb-1"><i class="bi bi-shop me-1 text-success"></i> @row.shopname</h5>
                                            <div class="text-secondary small">
                                                <i class="bi bi-gem text-success"></i>
                                                @row.shop_category
                                            </div>
                                        </div>

                                        @{
                                            if (row.isOpen != false)
                                            {
                                                <span class="badge d-flex align-items-center rounded-pill bg-success-subtle text-success border border-success-subtle">
                                                    <i class="bi bi-circle-fill me-1"
                                                       style="font-size: 7px;"></i>Open
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge rounded-pill d-flex align-items-center bg-danger-subtle text-danger border border-danger-subtle">
                                                    <i class="bi bi-circle-fill me-1"
                                                       style="font-size: 7px;"></i>Close
                                                </span>
                                            }
                                        }
                                    </div>

                                    <p class="small text-secondary mt-2 mb-3">
                                        @row.shop_tagline
                                    </p>

                                    <div class="row g-3">

                                        <div class="col-12 col-md-6">
                                            <div class="d-flex gap-2">
                                                <i class="bi bi-person-circle text-success fs-5"></i>
                                                <div>
                                                    <div class="text-secondary small">Shop Manager</div>
                                                    <div class="fw-semibold small">@row.shop_manager_name</div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-12 col-md-6">
                                            <div class="d-flex gap-2">
                                                <i class="bi bi-telephone text-success fs-5"></i>
                                                <div>
                                                    <div class="text-secondary small">Mobile Number</div>
                                                    <div class="fw-semibold small">@row.mobile</div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-12 col-md-6">
                                            <div class="d-flex gap-2">
                                                <i class="bi bi-geo-alt text-success fs-5"></i>
                                                <div>
                                                    <div class="text-secondary small">Shop Location</div>
                                                    <div class="fw-semibold small">
                                                        @row.shop_full_address @row.shop_city @row.shop_pincode
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-12 col-md-6">
                                            <div class="d-flex gap-2">
                                                <i class="bi bi-truck text-success fs-5"></i>
                                                <div>
                                                    <div class="text-secondary small">Delivery Radius</div>
                                                    <div class="fw-semibold small">@row.home_delivery_radius Km</div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-12 col-md-6">
                                            <div class="d-flex gap-2">
                                                <i class="bi bi-clock text-success fs-5"></i>
                                                <div>
                                                    <div class="text-secondary small">Opening Hours</div>
                                                    <div class="fw-semibold small">@row.shop_opening_time AM – @row.shop_closing_time PM</div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-12 col-md-6">
                                            <div class="d-flex gap-2">
                                                <i class="bi bi-envelope text-success fs-5"></i>
                                                <div>
                                                    <div class="text-secondary small">Email</div>
                                                    <div class="fw-semibold small text-break">
                                                        @row.shop_email
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                    </div>

                                    <hr class="my-3">

                                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                                        <span class="small text-secondary">
                                            Shop ID: <strong class="text-dark">ABZ-@row.shop_id</strong>
                                        </span>

                                        <div>

                                            @{
                                                if(row.isVerified == false)
                                                {
                                                    <a asp-action="VerifyTheShop" asp-controller="Merchant" asp-route-id="@row.shop_id" class="btn btn-sm btn-outline-danger border border-1 border-danger"><i class="bi bi-patch-check-fill"></i>Get Verify</a>
                                                }

                                                if(row.isOpen == false)
                                                {
                                                    <a asp-action="OpenShop" asp-controller="Merchant" asp-route-id="@row.shop_id" class="btn btn-sm btn-outline-success border border-1 border-success"><i class="bi bi-unlock"></i>Open Shop</a>
                                                }
                                                else
                                                {
                                                    <a asp-action="CloseShop" asp-controller="Merchant" asp-route-id="@row.shop_id" class="btn btn-sm btn-outline-danger border border-1 border-danger"><i class="bi bi-lock"></i>Close Shop</a>
                                                }
                                            }

                                            <a href="https://www.google.com/maps?q=@row.shop_latitude,@row.shop_longitude"
                                               target="_blank"
                                               rel="noopener noreferrer"
                                               class="btn btn-sm btn-light border">
                                                <i class="bi bi-map text-success me-1"></i>
                                                View Location
                                            </a>
                                        </div>
                                    </div>

                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            }

        }
        else
        {
            <div class="container py-4">
                <div class="card border-0 shadow-sm rounded-4 text-center p-4 p-md-5">

                    <div class="mb-3">
                        <div class="bg-light rounded-circle d-inline-flex
                            align-items-center justify-content-center"
                             style="width: 90px; height: 90px;">
                            <i class="bi bi-shop-window text-success"
                               style="font-size: 42px;"></i>
                        </div>
                    </div>

                    <h4 class="fw-bold text-dark mb-2">
                        No Shop Available
                    </h4>

                    <p class="text-secondary mx-auto mb-4"
                       style="max-width: 380px;">
                        You haven't added any shops yet. Start your journey
                        with ApnaBazaar by registering your first shop.
                    </p>

                    <div>
                        @{
                            if (ViewBag.isVerified == true)
                            {
                                <a asp-action="AddNewShop" asp-controller="Merchant" class="btn btn-sm btn-primary">
                                    <i class="bi bi-plus-circle-fill"></i> Add New Shop
                                </a>
                            }
                            else
                            {
                                <a onclick="checkAlert()" class="btn btn-sm btn-primary">
                                    <i class="bi bi-plus-circle-fill"></i> Add New Shop
                                </a>
                            }
                        }
                    </div>

                    <div class="mt-4 pt-3 border-top">
                        <small class="text-muted">
                            <i class="bi bi-lightbulb me-1"></i>
                            Your shop will help nearby customers discover you.
                        </small>
                    </div>
                </div>
            </div>

        }
    }

</main>


