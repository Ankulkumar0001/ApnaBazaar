<!-- ===== HERO SECTION ===== -->
<section class="hero-section" id="hero">

    <!-- Ambient Soothing Gradient Base -->
    <div class="hero-base-bg"></div>

    <!-- Center Content -->
    <div class="hero-inner">

        <!-- Location pill -->
        <div class="location-strip mt-4" id="locationStrip" onclick="getLiveLocation()" style="cursor:pointer">
            <i class="bi bi-geo-alt-fill" id="locationIcon"></i>
            <span id="locationText">Click to Refresh</span>
            <i class="bi bi-chevron-down ms-1" style="font-size:0.75rem;"></i>
        </div>

        <!-- Badge -->
        <div class="hero-tag">
            <i class="bi bi-lightning-charge-fill me-1"></i> India's #1 Local Shopping Platform
        </div>

        <!-- Title -->
        @* <span>@TempData["msg"]</span> *@
        <h1 class="hero-title">
            <svg class="hero-leaf leaf-left" viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="#4ade80" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z" />
                <path d="M2 21c0-3 1.85-5.36 5.08-6" />
            </svg>
            Shop From Your
            <svg class="hero-leaf leaf-right" viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="#4ade80" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z" />
                <path d="M2 21c0-3 1.85-5.36 5.08-6" />
            </svg>
            <br />
            <span class="hero-title-market">Neighbourhood Market</span>
        </h1>
        <p class="hero-sub">Fresh vegetables, groceries, dairy, snacks, personal care, household items, electronics &amp; much more — delivered to your door.</p>

        <!-- Search -->
        <div class="hero-search-wrap">
            <div class="hero-search-box">
                <div class="search-input-wrap">
                    <i class="bi bi-search search-icon"></i>
                    <input type="text" id="heroSearch" class="search-input" placeholder="Search sabzi, doodh, dukan..." />
                    <select class="form-control me-2" style="width:70px" id="distancebyUser">
                        <option value="3">3 Km</option>
                        <option value="5">5 Km</option>
                        <option value="8">8 Km</option>
                        <option value="10">10 Km</option>
                        <option value="15">15 Km</option>
                    </select>
                </div>
                <button class="search-btn" id="searchbtn" onclick="handleHeroSearch()">
                    <i class="bi bi-search me-1"></i>

                    <span id="text">
                        Search
                    </span>

                    <div class="spinner-grow spinner-grow-sm d-none" role="status" id="spinner">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </button>
            </div>

            <!-- Quick Tags -->
            <div class="quick-tags mt-3">
                <span class="qtag" onclick="qs('Grocery')">🛒 Grocery</span>
                <span class="qtag" onclick="qs('Vegetables')">🥦 Sabzi</span>
                <span class="qtag" onclick="qs('Fruits')">🍎 Fruits</span>
                <span class="qtag" onclick="qs('Dairy')">🥛 Dairy</span>
                <span class="qtag" onclick="qs('Bakery')">🍞 Bakery</span>
                <span class="qtag" onclick="qs('Pharmacy')">💊 Pharmacy</span>
                <span class="qtag" onclick="qs('Electronics')">📱 Electronics</span>
                <span class="qtag" onclick="qs('Clothing')">👕 Clothing</span>
                <span class="qtag" onclick="qs('Stationery')">📚 Stationery</span>
                <span class="qtag" onclick="qs('Hardware')">🔧 Hardware</span>
            </div>
        </div>

    </div>

    <!-- Stats Strip -->
    <div class="hero-stats">
        <div class="container-xl">
            <div class="row g-0 text-center">
                <div class="col-6 col-md-3 stat-item"><h4>120+</h4><p>Local Shops</p></div>
                <div class="col-6 col-md-3 stat-item"><h4>5K+</h4><p>Products</p></div>
                <div class="col-6 col-md-3 stat-item"><h4>10K+</h4><p>Happy Customers</p></div>
                <div class="col-6 col-md-3 stat-item"><h4>30 min</h4><p>Avg Delivery</p></div>
            </div>
        </div>
    </div>
</section>

