<!-- ===== SHOPS SECTION ===== -->
<section class="py-5 bg-light" id="shops">
    <div class="container-xl">
        <!-- Section Header -->
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
            <div>
                <span class="section-tag"><i class="bi bi-geo-alt-fill me-1"></i>Nearby Markets</span>
                <h2 class="section-title mb-1">Local <span class="text-orange">Shops & Dukanein</span></h2>
                <p class="text-muted small mb-0" id="shopsCountLabel">Showing all local neighbourhood shops</p>
            </div>
            <a href="#categories" class="btn-view-all">Browse Categories <i class="bi bi-arrow-right ms-1"></i></a>
        </div>

        <!-- Shops Grid (Populated dynamically) -->
        <div class="row g-4" id="shopsGrid">

            @* shop card start   *@
                @* render form api *@
            @* shop card end   *@

            
           


        </div>

        <!-- No Shops Found State -->
        <div id="noShopsState" class="text-center py-5 d-none">
            <div class="mb-3" style="font-size: 3.5rem;">🏬🔍</div>
            <h4 class="fw-bold mb-2">No Shops Found</h4>
            <p class="text-muted mb-3" id="noShopsMsg">No local shops match your search in this category.</p>
            <button class="btn btn-success rounded-pill px-4" onclick="resetShopFilters()"><i class="bi bi-arrow-counterclockwise me-1"></i> View All Shops</button>
        </div>

    </div>
</section>


<!-- ===== PRODUCTS SECTION ===== -->
<section class="py-5 bg-light" id="products">
    <div class="container-xl">
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
            <div>
                <span class="section-tag">Fresh Picks</span>
                <h2 class="section-title mb-0">Featured <span class="text-orange">Products</span></h2>
            </div>
            <a href="products.html" class="btn-view-all">View All <i class="bi bi-arrow-right ms-1"></i></a>
        </div>
        <div class="row g-4" id="productsGrid">

           @* render product here *@

        </div>
    </div>
</section>


<script>

    var searchInput = document.getElementById("heroSearch");

    searchInput.addEventListener("change", function () {
        
        var data = searchInput.value;
        if(data === ""){
            getAllShopAndAllProduct();
        }

    });

    var spinner = document.getElementById("spinner");
    var text = document.getElementById("text");
    getLiveLocation()

    function handleHeroSearch() {

        if (!searchInput) {
            console.error("heroSearch input nahi mila!");
            return;
        }

        const search = searchInput.value.trim();

        if (search === "") {
            getAllShopAndAllProduct();
            spinner.classList.remove("d-none")
            text.classList.add("d-none")
            document.getElementById("shops").scrollIntoView({
                                                        behavior: "smooth"
                                                    });

        } else {
            searchShopAndProductCat()
            spinner.classList.remove("d-none")
            text.classList.add("d-none")
            document.getElementById("shops").scrollIntoView({
                                                        behavior: "smooth"
                                                    });
        }
    }

    function getLiveLocation() {
        const text = document.getElementById("locationText");

        text.textContent = "Fetching your location...";

        // console.log("1. Function started");

        navigator.geolocation.getCurrentPosition(
            function(position) {
                // console.log("2. GPS SUCCESS");

                const lat = position.coords.latitude;
                const lon = position.coords.longitude;

                // console.log("Latitude:", lat);
                // console.log("Longitude:", lon);

                getLocationName(lat, lon).then(name => {
                    document.getElementById("locationText").textContent = name;
                });
            },
            function(error) {
                console.error("GPS ERROR:", error.code, error.message);

                text.textContent =
                    `GPS Error ${error.code}: ${error.message}`;
            },
            {
                enableHighAccuracy: false,
                timeout: 10000,
                maximumAge: 0
            }
        );
    }

    async function getLocationName(lat, lon) {
        const url = `https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat=${lat}&lon=${lon}&zoom=17&addressdetails=1`;

        try {
            const res = await fetch(url);
            const data = await res.json();

            // update location api start
           const id = @Context.Session.GetString("userid");
           try{
                var form = new FormData();
                form.append("id", id);
                form.append("latitude", lat);
                form.append("longitude", lon);

                var response = await fetch("http://localhost:5055/api/UserAPI/updateUserLocation", { method: "PATCH",body:form})

                if (!response.ok) {
                    console.log("not ok")
                    return "Unable to fetch location";
                }

                

           }catch (error){
                console.log("error")
                return "Unable to fetch location";
           }

            // update location api end

            return data.display_name || "Location not found";
        } catch {
            return "Unable to fetch location";
        }
    }
    
    async function getAllShopAndAllProduct(){

        try{
            var shoprow = document.getElementById("shopsGrid");
            var productsGrid = document.getElementById("productsGrid");
            const id = @Context.Session.GetString("userid");
            const distanceKM = document.getElementById("distancebyUser").value;

            shoprow.innerHTML = "";
            productsGrid.innerHTML = "";

            var response = await fetch(`http://localhost:5055/api/UserAPI/GetNearbyShops?id=${id}&distanceKm=${distanceKM}`);
            
            if(!response.ok){
                console.log("Response not ok");
                return
            }

            var data = await response.json();

            if(Array.isArray(data.data) && data.data.length > 0){

                for(var shop of data.data){

                    var image = "http://localhost:5055/images/" + shop.image
                    var row = `
                       <div class="col-12 col-md-6 col-lg-4">
                        <div class="shop-card">
                            <div class="shop-img">
                                        <img src="${image}" alt="shop photo" loading="lazy" />
                                    <span class="shop-tag">${shop.shop_category}</span>
                                        <span class="shop-dist-badge"><i class="bi bi-geo-alt-fill me-1"></i>${shop.distance} km</span>
                                <span class="shop-status">
                                 <span class="status-dot"></span>Open</span>

                            
                            </div>
                            <div class="shop-body">
                                <div class="d-flex justify-content-between align-items-start mb-1">
                                        <h3 class="shop-name mb-0">${shop.shopname}</h3>
                                            <span class="shop-cat-badge">${shop.shop_category}</span>
                                </div>
                                <div class="shop-area-text">
                                            <i class="bi bi-geo-alt-fill text-success"></i> ${shop.shop_full_address}
                                </div>
                                <div class="shop-details-grid">
                                                    <div class="shop-detail-item"><i class="bi bi-clock-fill"></i><span> ${shop.shop_opening_time} -  ${shop.shop_closing_time}</span></div>
                                    <div class="shop-detail-item"><i class="bi bi-box-seam-fill"></i><span>100</span></div>
                                            <div class="shop-detail-item"><i class="bi bi-truck"></i><span>${shop.home_delivery_radius}</span></div>
                                  
                                            <div class="shop-detail-item"><i class="bi bi-shield-check"></i><span>Verified Local</span></div>
                                    
                                </div>
                                <div class="shop-phone">
                                        <i class="bi bi-telephone-fill"></i> ${shop.mobile}
                                </div>
                            </div>
                            <div class="shop-footer">
                                <button class="shop-btn-primary">
                                    <i class="bi bi-shop me-2"></i> Visit Shop
                                </button>
                                    <a href="tel:${shop.mobile}" class="shop-btn-call" title="Call Shop">
                                    <i class="bi bi-telephone-fill"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                    `

                    shoprow.innerHTML += row;
                    spinner.classList.add("d-none")
                    text.classList.remove("d-none")
                    
                    

                }
            }
            else{
                var row = `
                         <div class="col-12">
                    <div class="card border-0 shadow-sm rounded-4 py-5 px-3">
                        <div class="card-body text-center">

                            <div class="bg-light rounded-circle d-inline-flex
                                align-items-center justify-content-center mb-4"
                                 style="width: 90px; height: 90px;">
                                <i class="bi bi-shop-window text-success"
                                   style="font-size: 3rem;"></i>
                            </div>

                            <h4 class="fw-bold text-dark mb-2">
                                No Shops Found
                            </h4>

                            <p class="text-secondary mx-auto mb-4"
                               style="max-width: 420px;">
                                We couldn't find any shops nearby.
                                Try increasing your search distance or
                                check back later for new stores.
                            </p>

                            <button type="button"
                                    class="btn btn-success rounded-pill px-4 py-2"
                                    onclick="getAllShopAndAllProduct()">
                                <i class="bi bi-arrow-clockwise me-2"></i>
                                Refresh Shops
                            </button>

                            <div class="mt-4">
                                <span class="badge bg-light text-secondary
                                    border rounded-pill px-3 py-2">
                                    <i class="bi bi-geo-alt me-1"></i>
                                    Discover local shops around you
                                </span>
                            </div>

                        </div>
                    </div>
                </div>
                `
                shoprow.innerHTML = row;
                spinner.classList.add("d-none")
                text.classList.remove("d-none")

            }


            if (Array.isArray(data.data_second) && data.data_second.length > 0) {
                for (var product of data.data_second) {

                    var image = "http://localhost:5055/images/" + product.product_image;
                var save = product.product_mrp - product.product_selling_price;
                var savepercentage = parseInt((save / product.product_mrp) * 100);
                var row = `
                        <div class="col-6 col-md-4 col-lg-3">
                    <div class="product-card">
                        <div class="product-img">
                            <img src="${image}" alt="Basmati Rice" />
                                <span class="disc-badge">-${savepercentage}%</span>
                        </div>
                        <div class="product-body">
                                <div class="p-cat-badge">${product.product_category}</div>
                                <div class="product-name">${product.product_name}</div>
                            <div class="p-meta-row">
                                        <span class="p-unit"><i class="bi bi-box-seam me-1"></i>${product.product_unit}</span>
                            </div>
                                <div class="p-shop"><i class="bi bi-shop me-1"></i>${product.shopname}</div>
                            <div class="product-price-row">
                                        <span class="p-price">₹${product.product_selling_price}</span>
                                        <span class="p-old">₹${product.product_mrp}</span>
                                <span class="p-save">Save ₹${save}</span>
                            </div>
                            <button class="add-cart-btn"><i class="bi bi-cart-plus"></i> Add to Cart</button>
                        </div>
                    </div>
                </div>
                `
                productsGrid.innerHTML += row;
                spinner.classList.add("d-none")
                text.classList.remove("d-none")
            }
          } 
          else{
              var row = `
                <div class="col-12">
                    <div class="card border-0 shadow-sm rounded-4 py-5 px-3">
                        <div class="card-body text-center">

                            <div class="bg-light rounded-circle d-inline-flex
                                        align-items-center justify-content-center mb-4"
                                    style="width: 90px; height: 90px;">
                                <i class="bi bi-basket3 text-success"
                                    style="font-size: 3rem;"></i>
                            </div>

                            <h4 class="fw-bold text-dark mb-2">
                                No Products Found
                            </h4>

                            <p class="text-secondary mx-auto mb-4"
                                style="max-width: 430px;">
                                Oops! We couldn't find any products nearby.
                                Try exploring another category or check back
                                later for exciting new arrivals.
                            </p>

                            <button type="button"
                                    class="btn btn-success rounded-pill px-4 py-2"
                                    onclick="getAllShopAndAllProduct()">
                                <i class="bi bi-arrow-clockwise me-2"></i>
                                Explore Again
                            </button>

                            <div class="mt-4">
                                <span class="badge bg-light text-secondary
                                                border rounded-pill px-3 py-2">
                                    <i class="bi bi-bag-heart me-1"></i>
                                    Discover something you love
                                </span>
                            </div>

                        </div>
                    </div>
                </div>

              `
                productsGrid.innerHTML = row;
                spinner.classList.add("d-none")
                text.classList.remove("d-none")
          }
            
        }catch (error){
            console.log(error.message)
        }

    }

    async function searchShopAndProductCat(){

