                                align-items-center justify-content-center mb-4"
                                 style="width: 90px; height: 90px;">
                                <i class="bi bi-shop-window text-success"
                                   style="font-size: 3rem;"></i>
                            </div>

                            <h4 class="fw-bold text-dark mb-2">
                                No Shops Found
                            </h4>

                            <p class="text-secondary mx-auto mb-4"
                               style="max-width: 420px;">
                                We couldn't find any shops nearby.
                                Try increasing your search distance or
                                check back later for new stores.
                            </p>

                            <button type="button"
                                    class="btn btn-success rounded-pill px-4 py-2"
                                    onclick="getAllShopAndAllProduct()">
                                <i class="bi bi-arrow-clockwise me-2"></i>
                                Refresh Shops
                            </button>

                            <div class="mt-4">
                                <span class="badge bg-light text-secondary
                                    border rounded-pill px-3 py-2">
                                    <i class="bi bi-geo-alt me-1"></i>
                                    Discover local shops around you
                                </span>
                            </div>

                        </div>
                    </div>
                </div>
                `
                shoprow.innerHTML = row;
                spinner.classList.add("d-none")
                text.classList.remove("d-none")

            }


            if (Array.isArray(data.data_second) && data.data_second.length > 0) {
                for (var product of data.data_second) {

                    var image = "http://localhost:5055/images/" + product.product_image;
                var save = product.product_mrp - product.product_selling_price;
                var savepercentage = parseInt((save / product.product_mrp) * 100);
                var row = `
                        <div class="col-6 col-md-4 col-lg-3">
                    <div class="product-card">
                        <div class="product-img">
                            <img src="${image}" alt="Basmati Rice" />
                                <span class="disc-badge">-${savepercentage}%</span>
                        </div>
                        <div class="product-body">
                                <div class="p-cat-badge">${product.product_category}</div>
                                <div class="product-name">${product.product_name}</div>
                            <div class="p-meta-row">
                                        <span class="p-unit"><i class="bi bi-box-seam me-1"></i>${product.product_unit}</span>
                            </div>
                                <div class="p-shop"><i class="bi bi-shop me-1"></i>${product.shopname}</div>
                            <div class="product-price-row">
                                        <span class="p-price">₹${product.product_selling_price}</span>
                                        <span class="p-old">₹${product.product_mrp}</span>
                                <span class="p-save">Save ₹${save}</span>
                            </div>
                            <button class="add-cart-btn"><i class="bi bi-cart-plus"></i> Add to Cart</button>
                        </div>
                    </div>
                </div>
                `
                productsGrid.innerHTML += row;
                spinner.classList.add("d-none")
                text.classList.remove("d-none")
            }
          } 
          else{
              var row = `
                <div class="col-12">
                    <div class="card border-0 shadow-sm rounded-4 py-5 px-3">
                        <div class="card-body text-center">

                            <div class="bg-light rounded-circle d-inline-flex
                                        align-items-center justify-content-center mb-4"
                                    style="width: 90px; height: 90px;">
                                <i class="bi bi-basket3 text-success"
                                    style="font-size: 3rem;"></i>
                            </div>

                            <h4 class="fw-bold text-dark mb-2">
                                No Products Found
                            </h4>

                            <p class="text-secondary mx-auto mb-4"
                                style="max-width: 430px;">
                                Oops! We couldn't find any products nearby.
                                Try exploring another category or check back
                                later for exciting new arrivals.
                            </p>

                            <button type="button"
                                    class="btn btn-success rounded-pill px-4 py-2"
                                    onclick="getAllShopAndAllProduct()">
                                <i class="bi bi-arrow-clockwise me-2"></i>
                                Explore Again
                            </button>

                            <div class="mt-4">
                                <span class="badge bg-light text-secondary
                                                border rounded-pill px-3 py-2">
                                    <i class="bi bi-bag-heart me-1"></i>
                                    Discover something you love
                                </span>
                            </div>

                        </div>
                    </div>
                </div>

              `
                productsGrid.innerHTML = row;
                spinner.classList.add("d-none")
                text.classList.remove("d-none")
          }
             
             spinner.classList.add("d-none")
             text.classList.remove("d-none")


        }catch(error){
            console.log("Response error");
        }
    }

</script>


