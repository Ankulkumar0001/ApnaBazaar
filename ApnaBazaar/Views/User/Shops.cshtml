@{
    Layout = "_WebsiteLayout";
    ViewBag.title = "Shops - ApnaBazaar | First Local Market Plateform";
}


<!-- ===== SHOPS HERO HEADER ===== -->
<section class="shops-page-hero">
    <div class="container-xl position-relative box">
        <div class="text-center mb-4">
            <span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill fw-semibold mb-2">
                <i class="bi bi-shop me-1"></i> Verified Local Dukanein
            </span>
            <h1 class="display-6 fw-bold text-white mb-2">
                Explore Local <span class="text-warning">Shops &amp; Markets</span>
            </h1>
            <p class="text-white-50 mb-4" style="max-width: 600px; margin: 0 auto;">
                Connect directly with verified local neighbourhood store owners, check available items, call, or order fresh essentials delivered to your doorstep.
            </p>

            <!-- Search Bar -->
            <div class="shops-search-wrap">
                <div class="input-group bg-white p-1 rounded-pill shadow-sm">
                    <span class="input-group-text bg-transparent border-0 ps-3 text-muted">
                        <i class="bi bi-search text-success"></i>
                    </span>
                    <input type="text"
                           id="heroSearch"
                           class="form-control border-0 shadow-none"
                           placeholder="Search shops by name, category, or area (e.g. Sharma, Grocery, Dadri)..."
                           oninput="handleSearch()" />
                    <button class="btn btn-outline-secondary border-0 rounded-pill px-3 d-none" id="searchClear" onclick="clearSearch()">
                        <i class="bi bi-x-circle"></i>
                    </button>
                    <button class="btn btn-success rounded-pill px-4" onclick="handleSearch()">
                        Search
                    </button>
                </div>
            </div>

        </div>

    </div>
</section>

