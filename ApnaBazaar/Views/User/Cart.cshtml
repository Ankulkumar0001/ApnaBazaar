    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    Layout = "_WebsiteLayout";
    ViewBag.title = "Chart - ApnaBazaar | First Local Market Plateform";
}


<!-- ===== CART HERO HEADER ===== -->
<section class="cart-page-hero">
    <div class="container-xl position-relative">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <span class="badge bg-success-subtle text-success px-3 py-1 rounded-pill fw-semibold mb-2">
                    <i class="bi bi-bag-check me-1"></i> My Shopping Bag
                </span>
                <h1 class="display-6 fw-bold text-white mb-1">
                    Your <span class="text-warning">Cart</span>
                </h1>
                <p class="text-white-50 mb-0">Review your neighbourhood store items and fast track your checkout</p>
            </div>
            <div>
                <a href="products.html" class="btn btn-outline-light rounded-pill px-4 btn-sm">
                    <i class="bi bi-arrow-left me-1"></i> Continue Shopping
                </a>
            </div>
        </div>
    </div>
</section>

<!-- ===== MAIN CART SECTION ===== -->
<section class="py-5 bg-light" style="min-height: 55vh;">
    <div class="container-xl">

        <div class="row g-4" id="cartActiveLayout">

            <!-- Left: Cart Items List -->
            <div class="col-12 col-lg-8">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0 text-dark">
                        Items in Cart (<span id="cartCountTitle">0</span>)
                    </h5>
                    <button class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="clearCart()">
                        <i class="bi bi-trash me-1"></i> Clear Cart
                    </button>
                </div>

                <!-- Items Stack -->
                <div class="d-flex flex-column gap-3" id="cartItemsList">
                    <!-- Rendered Dynamically -->
                </div>
            </div>

            <!-- Right: Order Summary Sidebar -->
            <div class="col-12 col-lg-4">
                <div class="order-summary-card">
                    <h5 class="fw-bold mb-3 text-dark">Bill Summary</h5>

                    <div class="summary-row">
                        <span>Item Total</span>
                        <span class="fw-semibold text-dark" id="summarySubtotal">₹0</span>
                    </div>

                    <div class="summary-row">
                        <span>Delivery Partner Fee</span>
                        <span class="text-success fw-semibold" id="summaryDelivery">FREE</span>
                    </div>

                    <div class="summary-row">
                        <span>Platform &amp; Packaging Fee</span>
                        <span class="text-success fw-semibold">FREE</span>
                    </div>

                    <div class="summary-row text-success">
                        <span>Total Discount Savings</span>
                        <span class="fw-bold" id="summarySavings">-₹0</span>
                    </div>

                    <div class="summary-total-row">
                        <span>To Pay</span>
                        <span class="text-success" id="summaryGrandTotal">₹0</span>
                    </div>

                    <!-- Delivery Address Card -->
                    <div class="bg-light p-3 rounded-3 mt-3 border">
                        <div class="d-flex align-items-center justify-content-between mb-1">
                            <span class="small fw-bold text-dark"><i class="bi bi-geo-alt-fill text-success me-1"></i> Delivering To</span>
                            <span class="badge bg-success-subtle text-success">Home</span>
                        </div>
                        <p class="small text-muted mb-0">Market Road, Dadri, Gautam Buddha Nagar</p>
                        <div class="small text-success fw-semibold mt-1">
                            <i class="bi bi-lightning-charge-fill"></i> Delivery in 20-30 mins
                        </div>
                    </div>

                    <!-- Checkout Button -->
                    <button class="btn btn-success w-100 py-3 rounded-pill fw-bold mt-4 shadow-sm" onclick="openCheckoutModal()">
                        <span>Proceed to Checkout</span>
                        <i class="bi bi-arrow-right ms-2"></i>
                    </button>

                    <div class="text-center mt-3">
                        <span class="small text-muted">
                            <i class="bi bi-shield-check text-success me-1"></i> 100% Safe Local Checkout
                        </span>
                    </div>

                </div>
            </div>

        </div>

        <!-- Empty Cart State -->
        <div class="empty-cart-state d-none" id="emptyCartView">
            <div class="empty-cart-icon">🛒</div>
            <h3 class="fw-bold text-dark mb-2">Your Cart is Empty</h3>
            <p class="text-muted mb-4" style="max-width: 420px; margin: 0 auto;">
                Looks like you haven't added anything to your cart yet. Explore fresh groceries, dairy, and local essentials!
            </p>
            <div class="d-flex justify-content-center gap-3">
                <a href="products.html" class="btn btn-success rounded-pill px-4 py-2 fw-semibold">
                    <i class="bi bi-bag-plus me-1"></i> Browse Products
                </a>
                <a href="shops.html" class="btn btn-outline-success rounded-pill px-4 py-2 fw-semibold">
                    <i class="bi bi-shop me-1"></i> Explore Shops
                </a>
            </div>
        </div>

    </div>
</section>

<!-- ===== CHECKOUT CONFIRMATION MODAL ===== -->
<div class="modal fade" id="checkoutModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg overflow-hidden">
            <div class="modal-header bg-success text-white border-0 py-3">
                <h5 class="modal-title fw-bold"><i class="bi bi-check-circle me-2"></i> Confirm Your Order</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="text-center mb-4">
                    <div class="display-5 text-success mb-2">🎉</div>
                    <h5 class="fw-bold">Ready to place your order?</h5>
                    <p class="text-muted small">Your order will be sent directly to neighbourhood shops for immediate dispatch.</p>
                </div>

                <div class="card bg-light border-0 p-3 rounded-3 mb-3">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted small">Total Payable Amount:</span>
                        <span class="fw-bold text-dark" id="modalPayableAmount">₹0</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted small">Payment Mode:</span>
                        <span class="fw-bold text-success">Cash on Delivery / UPI on Delivery</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted small">Estimated Delivery:</span>
                        <span class="fw-bold text-dark">20-30 Minutes</span>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold">Delivery Contact Mobile</label>
                    <input type="tel" class="form-control rounded-3" value="+91 98765 43210" id="orderPhone" placeholder="Enter contact mobile number" />
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold">Delivery Instructions (Optional)</label>
                    <input type="text" class="form-control rounded-3" placeholder="e.g. Leave at door, call on arrival" />
                </div>

            </div>
            <div class="modal-footer bg-light border-0 py-3 px-4">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success rounded-pill px-4 fw-bold" onclick="placeOrder()">Place Order</button>
            </div>
        </div>
    </div>
</div>