@model ApnaBazaar.Models.changepassword
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    Layout = "_WebsiteLayout";
    ViewBag.title = "Change Password - ApnaBazaar | First Local Market Plateform";
}


<!-- Fullscreen Auth Wrapper -->
<div class="auth-wrapper">

    <!-- Hero Matched Aurora & Tech-Dot Grid Background -->
    <div class="auth-bg"></div>

    <!-- White Compact Reset Card -->
    <div class="auth-card">

        <!-- Brand Logo -->
        <a  class="auth-brand">
            <img src="~/images/ApnaBazaar_logo_without_bg.png" alt="ApnaBazaar Logo" />
            <span class="auth-brand-name fw-bold">
                <span class="brand-apna">Apna</span><span class="brand-bazaar">Bazaar</span>
            </span>
        </a>

        <!-- Header -->
        <div class="auth-header">
           
            <h1 class="auth-title">Change Your Password</h1>
            <p class="auth-subtitle">Create a strong, secure password to protect your account. Choose a unique password you haven't used before, and keep your information safe.</p>
        </div>

        <!-- Step 3 Form: Create New Password -->
        <form asp-action="ChangeUserpassword" method="post" onsubmit="showspinner()">

            <!-- old Password -->
            <div class="auth-field">
                <label class="auth-label" for="userNewPassword">Old Password</label>
                <div class="auth-input-wrap">
                    <i class="bi bi-lock auth-input-icon"></i>
                    <input type="password"
                           id="userNewPassword"
                           class="auth-input"
                           asp-for="oldpassword"
                           placeholder="Enter your old password"
                           required
                           minlength="6"
                           autocomplete="new-password" />
                </div>
            </div>

            <!-- New Password -->
            <div class="auth-field">
                <label class="auth-label" for="userNewPassword">New Password</label>
                <div class="auth-input-wrap">
                    <i class="bi bi-lock auth-input-icon"></i>
                    <input type="password"
                           id="userNewPassword"
                           asp-for="newpassword"
                           class="auth-input"
                           placeholder="At least 6 characters"
                           required
                           minlength="6"
                           autocomplete="new-password" />
                </div>
            </div>

            <!-- Confirm Password -->
            <div class="auth-field">
                <label class="auth-label" for="userConfirmPassword">Confirm Password</label>
                <div class="auth-input-wrap">
                    <i class="bi bi-shield-lock auth-input-icon"></i>
                    <input type="password"
                           id="userConfirmPassword"
                           class="auth-input"
                           asp-for="confirmpassword"
                           placeholder="Re-enter your new password"
                           required
                           minlength="6"
                           autocomplete="new-password" />
                </div>
            </div>

            <button type="submit" class="btn-auth-submit mt-3" id="submitBtn">

                <div class="spinner-grow spinner-grow-sm d-none" role="status" id="spinner">
                    <span class="visually-hidden">Loading...</span>
                </div>

                <span id="text">

                    <span>Update Password &amp; Login</span>
                    <i class="bi bi-check-lg"></i>

                </span>
            </button>

        </form>

    </div>
</div>




