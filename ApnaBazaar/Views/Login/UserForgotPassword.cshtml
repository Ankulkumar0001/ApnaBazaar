@model ApnaBazaar.Models.ForEmailAndOTP
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    Layout = "_AuthLayout";
    ViewBag.title = "Forgot Password (Step 1) – ApnaBazaar";
}


    <!-- Fullscreen Auth Wrapper -->
    <div class="auth-wrapper">

        <!-- Hero Matched Aurora & Tech-Dot Grid Background -->
        <div class="auth-bg"></div>

        <!-- White Compact Reset Card -->
        <div class="auth-card">

            <!-- Brand Logo -->
        <a asp-action="UserForgotPassword" asp-controller="Login" class="auth-brand" >
                <img src="~/images/ApnaBazaar_logo_without_bg.png" alt="ApnaBazaar Logo" />
                <span class="auth-brand-name fw-bold">
                    <span class="brand-apna">Apna</span><span class="brand-bazaar">Bazaar</span>
                </span>
            </a>

            <!-- Header -->
            <div class="auth-header">
                <span class="auth-badge">
                    <i class="bi bi-1-circle-fill me-1"></i> Step 1 of 3 · Enter Email
                </span>
                <h1 class="auth-title">Forgot Password</h1>
                <p class="auth-subtitle">Enter your registered email address to receive an OTP code</p>
            </div>

            <!-- Step 1 Form: Enter Email -->
        <form asp-action="SendForgotOTP" method="post" onsubmit="showspinner()">

                <div class="auth-field">
                    <label class="auth-label" for="userEmail">Registered Email Address</label>
                    <div class="auth-input-wrap">
                        <i class="bi bi-envelope auth-input-icon"></i>
                        <input type="email"
                               id="userEmail"
                               asp-for="email"
                               class="auth-input"
                               placeholder="e.g. rahul@example.com"
                               required
                               autocomplete="email" />
                    </div>
                </div>

            <button type="submit" class="btn-auth-submit mt-2" id="submitBtn">

                <div class="spinner-grow spinner-grow-sm d-none" role="status" id="spinner">
                    <span class="visually-hidden">Loading...</span>
                </div>


                    <span id="text">
                        
                    <span>Send OTP Code</span>
                    <i class="bi bi-arrow-right"></i>

                    </span>
                </button>

            </form>

            <!-- Footer Links -->
            <div class="auth-card-footer">
                <p class="mb-1">Remembered password? <a asp-action="Index" asp-controller="Login">Login here</a></p>
               
            </div>

        </div>
    </div>


