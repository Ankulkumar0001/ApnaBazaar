@model ApnaBazaar.Models.UserTable
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    Layout = "_AuthLayout";
    ViewBag.title = "Register – ApnaBazaar | Local Shopping Platform";
}


    <!-- Fullscreen Auth Wrapper -->
    <div class="auth-wrapper">

        <!-- Hero Section Matched Aurora & Tech-Dot Grid Background -->
        <div class="auth-bg"></div>

        <!-- Frosted Glass Register Card -->
        <div class="auth-card">

            <!-- Brand Logo -->
        <a asp-action="UserRegister" asp-controller="Login" class="auth-brand" >
                <img src="~/images/ApnaBazaar_logo_without_bg.png" alt="ApnaBazaar Logo" />
                <span class="auth-brand-name fw-bold">
                    <span class="brand-apna">Apna</span><span class="brand-bazaar">Bazaar</span>
                </span>
            </a>

            <!-- Header -->
            <div class="auth-header">
                <h1 class="auth-title">Create an Account</h1>
                <p class="auth-subtitle">Register to discover &amp; shop from verified local shops</p>
            </div>

            <!-- Registration Form (Pure HTML) -->
        <form id="registerForm" method="post" asp-action="AddUser" onsubmit="showspinner()">

                <!-- 1. Full Name -->
                <div class="auth-field">
                    <label class="auth-label" for="regName">Full Name</label>
                    <div class="auth-input-wrap">
                        <i class="bi bi-person auth-input-icon"></i>
                        <input type="text"
                               id="regName"
                               asp-for="name"
                               class="auth-input"
                               placeholder="e.g. Rahul Sharma"
                               required
                               minlength="2"
                               autocomplete="name" />
                    </div>
                </div>

                <!-- 2. Email Address -->
                <div class="auth-field">
                    <label class="auth-label" for="regEmail">Email Address</label>
                    <div class="auth-input-wrap">
                        <i class="bi bi-envelope auth-input-icon"></i>
                        <input type="email"
                               id="email"
                               asp-for="email"
                               class="auth-input"
                               placeholder="name@example.com"
                               required
                               autocomplete="email" />
                    </div>
                </div>

                <!-- 3. Mobile Number -->
                <div class="auth-field">
                    <label class="auth-label" for="regMobile">Mobile Number</label>
                    <div class="mobile-input-wrap">
                        <span class="country-prefix">+91</span>
                        <div class="auth-input-wrap flex-grow-1">
                            <i class="bi bi-phone auth-input-icon"></i>
                            <input type="tel"
                                   id="regMobile"
                                   asp-for="mobile"
                                   class="auth-input"
                                   placeholder="10-digit mobile number"
                                   maxlength="10"
                                   pattern="[0-9]{10}"
                                   required
                                   autocomplete="tel-national" />
                        </div>
                    </div>
                </div>

                <!-- 4. Password -->
                <div class="auth-field">
                    <label class="auth-label" for="regPassword">Password</label>
                    <div class="auth-input-wrap">
                        <i class="bi bi-lock auth-input-icon"></i>
                        <input type="password"
                               id="regPassword"
                               asp-for="password"
                               class="auth-input"
                               placeholder="At least 6 characters"
                               required
                               minlength="6"
                               autocomplete="new-password" />
                    </div>
                </div>

                <!-- 5. Confirm Password -->
                <div class="auth-field">
                    <label class="auth-label" for="regConfirmPassword">Confirm Password</label>
                    <div class="auth-input-wrap">
                        <i class="bi bi-shield-lock auth-input-icon"></i>
                        <input type="password"
                               id="regConfirmPassword"
                               asp-for="confirmPassword"
                               class="auth-input"
                               placeholder="Re-enter your password"
                               required
                               minlength="6"
                               autocomplete="new-password" />
                    </div>
                </div>

                <!-- Terms Agreement -->
                <label class="auth-terms">
                    <input type="checkbox" id="termsAgree" name="terms" required checked />
                    <span>I agree to the <a href="#" target="_blank">Terms &amp; Conditions</a> and <a href="#" target="_blank">Privacy Policy</a></span>
                </label>

                <!-- Submit Button -->
                <button type="submit" class="btn-auth-submit" id="submitBtn">

                <div class="spinner-grow spinner-grow-sm d-none" role="status" id="spinner">
                    <span class="visually-hidden">Loading...</span>
                </div>


                   <span id="text">

                    <span>Create Account</span>
                    <i class="bi bi-arrow-right"></i>

                   </span>
                </button>

            </form>

            <!-- Footer Links -->
            <div class="auth-card-footer">
                <p class="mb-1">Already have an account? <a asp-action="Index" asp-controller="Login">Login here</a></p>
                    <span>@TempData["msg"]</span>
            </div>

        </div>
    </div>


