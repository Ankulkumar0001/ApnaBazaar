@model ApnaBazaar.Models.UserLogin
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    Layout = "_AuthLayout";
    ViewBag.title = "Login – ApnaBazaar | Local Shopping Platform";
}


    <!-- Fullscreen Auth Wrapper -->
    <div class="auth-wrapper">

        <!-- Hero Section Matched Aurora & Tech-Dot Grid Background -->
        <div class="auth-bg"></div>

        <!-- Frosted Glass Login Card -->
        <div class="auth-card">

            <!-- Brand Logo -->
            <a asp-action="Index" asp-controller="Login" class="auth-brand" >
                <img src="~/images/ApnaBazaar_logo_without_bg.png" alt="ApnaBazaar Logo" />
                <span class="auth-brand-name fw-bold">
                    <span class="brand-apna">Apna</span><span class="brand-bazaar">Bazaar</span>
                </span>
            </a>

            <!-- Header -->
            <div class="auth-header">
                <h1 class="auth-title">Welcome Back</h1>
                <p class="auth-subtitle">Login to your account to continue shopping locally</p>
            </div>

            <!-- Login Form (Pure HTML) -->
        <form id="loginForm" method="post" asp-action="UsersLogin" onsubmit="showspinner()">

                <!-- Email Address -->
                <div class="auth-field">
                    <label class="auth-label" for="loginEmail">Email Address</label>
                    <div class="auth-input-wrap">
                        <i class="bi bi-envelope auth-input-icon"></i>
                        <input type="email"
                               id="loginEmail"
                               asp-for="email"
                               class="auth-input"
                               placeholder="e.g. rahul@example.com"
                               required
                               autocomplete="email" />
                    </div>
                </div>

                <!-- Password -->
                <div class="auth-field">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label class="auth-label mb-0" for="loginPassword">Password</label>
                        <a asp-action="UserForgotPassword" asp-controller="Login" class="small text-decoration-none" style="color:#86efac;font-size:0.75rem;">Forgot Password?</a>
                    </div>
                    <div class="auth-input-wrap">
                        <i class="bi bi-lock auth-input-icon"></i>
                        <input type="password"
                               id="loginPassword"
                               asp-for="password"
                               class="auth-input"
                               placeholder="Enter your password"
                               required
                               autocomplete="current-password" />
                    </div>
                </div>

                <!-- Remember Me -->
                <label class="auth-terms">
                    <input type="checkbox" id="rememberMe" name="rememberMe" checked />
                    <span>Remember me on this device</span>
                </label>

                <!-- Submit Button -->
                <button type="submit" class="btn-auth-submit" id="submitBtn">
              
                    <div class="spinner-grow spinner-grow-sm d-none" role="status" id="spinner">
                        <span class="visually-hidden">Loading...</span>
                    </div>
  
                   <span id="text">

                        <span>Login</span>
                        <i class="bi bi-arrow-right"></i>

                    </span>
                        
                </button>
                 
          

            </form>

            @* <a asp-action="LoginWithOTP" asp-controller="Login"  class="btn-auth-submit mt-3 text-decoration-none" id="submitBtn">
                <span>Login With OTP</span>
                <i class="bi bi-arrow-right"></i>
            </a> *@

            <!-- Footer Links -->
            <div class="auth-card-footer">
                <p class="mb-1">Don't Remember Password? <a asp-action="LoginWithOTP" asp-controller="Login">Login with OTP</a></p>
                <p class="mb-1">Don't have an account? <a asp-action="UserRegister" asp-controller="Login">Register here</a></p>
                <p class="mb-1">Don't have an account? <a asp-action="MerchantLogin" asp-controller="Login">Login as Merchant here</a></p>
            </div>

        </div>
    </div>

    





