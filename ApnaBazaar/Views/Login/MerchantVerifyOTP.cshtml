@model ApnaBazaar.Models.ForEmailAndOTP
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    Layout = "_AuthLayout";
    ViewBag.title = "Merchant Verify OTP (Step 2) – ApnaBazaar";
}


    <!-- Fullscreen Auth Wrapper -->
    <div class="auth-wrapper">

        <!-- Hero Matched Aurora & Tech-Dot Grid Background -->
        <div class="auth-bg"></div>

        <!-- White Compact Reset Card -->
        <div class="auth-card">

            <!-- Brand Logo -->
            <a asp-action="MerchantVerifyOTP" asp-controller="Login" class="auth-brand">
                <img src="~/images/ApnaBazaar_logo_without_bg.png" alt="ApnaBazaar Logo" />
                <span class="auth-brand-name fw-bold">
                    <span class="brand-apna">Apna</span><span class="brand-bazaar">Bazaar</span>
                </span>
            </a>

            <!-- Header -->
            <div class="auth-header">
                <span class="auth-badge">
                    <i class="bi bi-2-circle-fill me-1"></i> Step 2 of 3 · Verify OTP
                </span>
                <h1 class="auth-title">Verify Merchant OTP</h1>
                <p class="auth-subtitle">Enter the 4-digit code sent to your registered merchant email</p>
            </div>

            <!-- Merchant Step 2 Form: Verify OTP -->
        <form asp-action="VerifyMOTP" method="post" onsubmit="showspinner()">

                <div class="auth-field">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label class="auth-label mb-0" for="merchantOtp">Verification Code (OTP)</label>
                        <span class="badge bg-light text-success border border-success-subtle px-2 py-1" style="font-size:0.7rem;">OTP Sent</span>
                    </div>
                    <div class="auth-input-wrap">
                        <i class="bi bi-key auth-input-icon"></i>
                        <input type="text"
                               id="merchantOtp"
                               asp-for="otp"
                               class="auth-input text-center fw-bold fs-5"
                               placeholder="e.g. 5831"
                               maxlength="6"
                               pattern="[0-9]{4,6}"
                               required
                               inputmode="numeric" />
                    </div>
                    <div class="d-flex justify-content-between align-items-center mt-2">
                        <span class="small text-muted">Didn't receive code?</span>
                        <a href="shop-forgot-password.html" class="small text-success fw-semibold text-decoration-none">Resend OTP</a>
                    </div>
                </div>

            <button type="submit" class="btn-auth-submit mt-3" id="submitBtn">

                <div class="spinner-grow spinner-grow-sm d-none" role="status" id="spinner">
                    <span class="visually-hidden">Loading...</span>
                </div>

                   <span id="text">

                    <span>Verify &amp; Proceed</span>
                    <i class="bi bi-arrow-right"></i>

                   </span>
                </button>

            </form>

            <!-- Footer Links -->
            <div class="auth-card-footer">
                <p class="mb-1"><a asp-action="MerchantForgotPassword" asp-controller="Login">← Change Merchant Email</a></p>
               
            </div>

        </div>
    </div>



