@model ApnaBazaar.Models.MerchantTable
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    Layout = "_AuthLayout";
    ViewBag.title = "Merchant Registration – ApnaBazaar | Join as Merchant Partner";
}



    <!-- Fullscreen Auth Wrapper -->
    <div class="auth-wrapper">

        <!-- Hero Section Matched Aurora & Tech-Dot Grid Background -->
        <div class="auth-bg"></div>

        <!-- White Compact Merchant Card -->
        <div class="auth-card auth2">

            <!-- Brand Logo -->
            <a asp-action="MerchantLogin" asp-controller="Login" class="auth-brand">
                <img src="~/images/ApnaBazaar_logo_without_bg.png" alt="ApnaBazaar Logo" />
                <span class="auth-brand-name fw-bold">
                    <span class="brand-apna">Apna</span><span class="brand-bazaar">Bazaar</span>
                </span>
            </a>
                
            <!-- Header -->
            <div class="auth-header">
                <span class="auth-badge">
                    <i class="bi bi-briefcase me-1"></i> Merchant Partner
                </span>
                <h1 class="auth-title">Register as Merchant</h1>
                <p class="auth-subtitle">Create your merchant account to start partnering with ApnaBazaar</p>
            </div>

            <!-- Merchant Registration Form (Pure HTML) -->
            <form id="merchantRegisterForm" method="post" asp-action="AddMerchant" onsubmit="showspinner()">

                <div class="d-flex justify-content-between gap-3" style="width:100%">

                    <!-- 1. Full Name -->
                    <div class="auth-field w-100">
                        <label class="auth-label" for="merchantName">Full Name</label>
                        <div class="auth-input-wrap">
                            <i class="bi bi-person auth-input-icon"></i>
                            <input type="text"
                                   id="merchantName"
                                   asp-for="name"
                                   class="auth-input"
                                   placeholder="e.g. Ramesh Sharma"
                                   required
                                   minlength="2"
                                   autocomplete="name" />
                        </div>
                    </div>

                    <!-- 2. Email Address -->
                    <div class="auth-field w-100">
                        <label class="auth-label" for="merchantEmail">Email Address</label>
                        <div class="auth-input-wrap">
                            <i class="bi bi-envelope auth-input-icon"></i>
                            <input type="email"
                                   id="merchantEmail"
                                   asp-for="email"
                                   class="auth-input"
                                   placeholder="merchant@example.com"
                                   required
                                   autocomplete="email" />
                        </div>
                    </div>

                </div>

                <div class="d-flex justify-content-between gap-3" style="width:100%">

                    <!-- 3. Mobile Number -->
                    <div class="auth-field w-100">
                        <label class="auth-label" for="merchantMobile">Mobile Number</label>
                        <div class="mobile-input-wrap">
                            <span class="country-prefix">+91</span>
                            <div class="auth-input-wrap flex-grow-1">
                                <i class="bi bi-telephone auth-input-icon"></i>
                                <input type="tel"
                                       id="merchantMobile"
                                       asp-for="mobile"
                                       class="auth-input"
                                       placeholder="10-digit mobile number"
                                       maxlength="10"
                                       pattern="[0-9]{10}"
                                       required
                                       autocomplete="tel-national" />
                            </div>
                        </div>
                    </div>

                    <!-- 3. alt Mobile Number -->
                    <div class="auth-field w-100">
                        <label class="auth-label" for="merchantaltMobile">Alternate Mobile Number</label>
                        <div class="mobile-input-wrap">
                            <span class="country-prefix">+91</span>
                            <div class="auth-input-wrap flex-grow-1">
                                <i class="bi bi-telephone auth-input-icon"></i>
                                <input type="tel"
                                       id="merchantaltMobile"
                                       asp-for="altMobile"
                                       class="auth-input"
                                       placeholder="10-digit alt-mobile number"
                                       maxlength="10"
                                       pattern="[0-9]{10}"
                                       required
                                       autocomplete="tel-national" />
                            </div>
                        </div>
                    </div>

                </div>

                <div class="d-flex justify-content-between gap-3" style="width:100%">

                    <!-- 1. aadhar card -->
                    <div class="auth-field w-100">
                        <label class="auth-label" for="merchantaadhar">Aadhar Card Number</label>
                        <div class="auth-input-wrap">
                        <i class="bi bi-person-square auth-input-icon"></i>
                            <input type="number"
                                   id="merchantaadhar"
                                   asp-for="aadharNumber"
                                   class="auth-input"
                                   placeholder="xxxx xxxx 2154"
                                   required
                                   minlength="12"
                                   maxlength="12"
                                   autocomplete="aadhar" />
                        </div>
                    </div>

                    <!-- 1. Full address -->
                    <div class="auth-field w-100">
                        <label class="auth-label" for="merchantAddress">Full Address</label>
                        <div class="auth-input-wrap">
                        <i class="bi bi-geo-alt auth-input-icon"></i>
                            <input type="text"
                                   id="merchantAddress"
                                   asp-for="address"
                                   class="auth-input"
                                   placeholder="e.g. surajpur grater noida UP"
                                   required
                                   minlength="2"
                                   autocomplete="address" />
                        </div>
                    </div>

                </div>

               <div class="d-flex justify-content-between gap-3" style="width:100%">

                    <!-- 1. gender -->
                    <div class="auth-field w-100">
                        <label class="auth-label" for="merchantGender">Gender</label>
                        <div class="auth-input-wrap">
                        <i class="bi bi-gender-female auth-input-icon"></i>
                            <select asp-for="gender" required id="merchantGender" class="auth-input">
                                <option value="male" selected>Male</option>
                                <option value="female">Female</option>
                                <option value="prefer_not">Prefer not to say</option>
                            </select>
                        </div>
                    </div>

                    <!-- 1. dob -->
                    <div class="auth-field w-100">
                        <label class="auth-label" for="merchantDOB">D.O.B</label>
                        <div class="auth-input-wrap">
                        <i class="bi bi-calendar-date auth-input-icon"></i>
                            <input type="date"
                                   id="merchantDOB"
                                   asp-for="dob"
                                   class="auth-input"
                                   required />
                        </div>
                    </div>

               </div>

               <div class="d-flex justify-content-between gap-3" style="width:100%">

                <!-- 4. Password -->
                <div class="auth-field w-100">
                    <label class="auth-label" for="merchantPassword">Set Password</label>
                    <div class="auth-input-wrap">
                        <i class="bi bi-lock auth-input-icon"></i>
                        <input type="password"
                               id="merchantPassword"
                               asp-for="password"
                               class="auth-input"
                               placeholder="At least 6 characters"
                               required
                               minlength="6"
                               autocomplete="new-password" />
                    </div>
                </div>

                <!-- 5. Confirm Password -->
                <div class="auth-field w-100">
                    <label class="auth-label" for="merchantConfirmPassword">Confirm Password</label>
                    <div class="auth-input-wrap">
                        <i class="bi bi-shield-lock auth-input-icon"></i>
                        <input type="password"
                               id="merchantConfirmPassword"
                               asp-for="confirmPassword"
                               class="auth-input"
                               placeholder="Re-enter your password"
                               required
                               minlength="6"
                               autocomplete="new-password" />
                    </div>
                </div>

               </div>

                <!-- Merchant Terms Agreement -->
                <label class="auth-terms">
                    <input type="checkbox" id="merchantTerms" name="terms" required checked />
                    <span>I agree to the <a href="#" target="_blank">Merchant Partner Terms</a> and <a href="#" target="_blank">Privacy Policy</a></span>
                </label>

                <!-- Submit Button -->
                <button type="submit" class="btn-auth-submit" id="submitBtn">


                <div class="spinner-grow spinner-grow-sm d-none" role="status" id="spinner">
                    <span class="visually-hidden">Loading...</span>
                </div>

                   <span id="text">

                    <span>Register as Merchant</span>
                    <i class="bi bi-arrow-right"></i>

                   </span>
                </button>

            </form>

            <!-- Footer Links -->
            <div class="auth-card-footer">
                <p class="mb-1">Already registered as a Merchant? <a asp-action="MerchantLogin" asp-controller="Login">Merchant Login</a></p>
               
            </div>

        </div>
    </div>


