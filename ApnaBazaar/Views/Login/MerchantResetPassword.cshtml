@model ApnaBazaar.Models.MerchantTable
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    Layout = "_AuthLayout";
    ViewBag.title = "Merchant Reset Password (Step 3) – ApnaBazaar";
}


    <!-- Fullscreen Auth Wrapper -->
    <div class="auth-wrapper">

        <!-- Hero Matched Aurora & Tech-Dot Grid Background -->
        <div class="auth-bg"></div>

        <!-- White Compact Reset Card -->
        <div class="auth-card">

            <!-- Brand Logo -->
            <a asp-action="MerchantResetPassword" asp-controller="Login" class="auth-brand" >
                <img src="~/images/ApnaBazaar_logo_without_bg.png" alt="ApnaBazaar Logo" />
                <span class="auth-brand-name fw-bold">
                    <span class="brand-apna">Apna</span><span class="brand-bazaar">Bazaar</span>
                </span>
            </a>

            <!-- Header -->
            <div class="auth-header">
                <span class="auth-badge">
                    <i class="bi bi-3-circle-fill me-1"></i> Step 3 of 3 · New Password
                </span>
                <h1 class="auth-title">Create Merchant Password</h1>
                <p class="auth-subtitle">Set a strong new password for your merchant portal account</p>
            </div>

            <!-- Merchant Step 3 Form: Create New Password -->
        <form asp-action="ResetMerchantPass" method="post" onsubmit="showspinner()">

                <!-- New Password -->
                <div class="auth-field">
                    <label class="auth-label" for="merchantNewPassword">New Password</label>
                    <div class="auth-input-wrap">
                        <i class="bi bi-lock auth-input-icon"></i>
                        <input type="password"
                               id="merchantNewPassword"
                               asp-for="password"
                               class="auth-input"
                               placeholder="At least 6 characters"
                               required
                               minlength="6"
                               autocomplete="new-password" />
                    </div>
                </div>

                <!-- Confirm Password -->
                <div class="auth-field">
                    <label class="auth-label" for="merchantConfirmPassword">Confirm Password</label>
                    <div class="auth-input-wrap">
                        <i class="bi bi-shield-lock auth-input-icon"></i>
                        <input type="password"
                               id="merchantConfirmPassword"
                               asp-for="confirmPassword"
                               class="auth-input"
                               placeholder="Re-enter your new password"
                               required
                               minlength="6"
                               autocomplete="new-password" />
                    </div>
                </div>

                <button type="submit" class="btn-auth-submit mt-2" id="submitBtn">

                <div class="spinner-grow spinner-grow-sm d-none" role="status" id="spinner">
                    <span class="visually-hidden">Loading...</span>
                </div>

                    <span id="text">
                    <span>Update Password &amp; Login</span>
                    <i class="bi bi-check-lg"></i>
                    </span>
                </button>

            </form>

            <!-- Footer Links -->
            <div class="auth-card-footer">
                <p class="mb-1"><a asp-action="MechantVerifyOTP" asp-controller="Login">← Back to OTP verification</a></p>
                <div>
                    <a asp-action="MerchantLogin" asp-controller="Login" class="auth-back-link">
                        <i class="bi bi-arrow-left"></i> Cancel &amp; Back to Merchant Login
                    </a>
                </div>
            </div>

        </div>
    </div>

